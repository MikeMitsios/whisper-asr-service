# Copy to .env and fill in. .env is gitignored; never commit real values.

# Hugging Face token. Only needed for gated models or to stream the
# Emilia-Dataset used by scripts/evaluation.py. Create one at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Overrides redis_url from the YAML config. docker compose sets this itself.
# REDIS_URL=redis://localhost:6379/0

# Which YAML config the service loads.
# CONFIG_PATH=configs/cpu.yml
